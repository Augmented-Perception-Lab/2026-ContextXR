{
  "app": "books",
  "icon": "book-open",
  "color": "#ff9f0a",
  "facets": {
    "books.open_section": {
      "blocks": [
        {"type": "tabs", "selected": 0, "items": [
          {"cap": "open_browse_library", "label": "Library", "icon": "library"},
